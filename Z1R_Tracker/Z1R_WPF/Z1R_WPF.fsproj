<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Some dialogs / clipboard helpers use System.Windows.Forms types -->
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>Exe</OutputType>
    <AssemblyName>Z1R_WPF</AssemblyName>
    <RootNamespace>Z1R_WPF</RootNamespace>
    <ApplicationIcon>icons\ztlogo64x64.ico</ApplicationIcon>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OtherFlags>--warnon:1182</OtherFlags>
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
    <Tailcalls Condition="'$(Configuration)' == 'Release'">true</Tailcalls>
    <NoWarn Condition="'$(Configuration)' == 'Release'">40</NoWarn>
    <!-- Debug start args preserved as a comment; set via VS launch profile instead
         Debug: heartShuffle 1    Release: noHeartShuffle 3 -->
  </PropertyGroup>

  <!-- ───────────────────────────────────────────────────
       External NuGet packages.
       Everything that ships in the .NET 8 runtime (System.Text.Json,
       System.IO.Pipelines, all Microsoft.Extensions.*, etc.) is omitted —
       they are pulled in automatically by the SDK or as transitive deps from
       Microsoft.AspNetCore.SignalR.Client.
       ─────────────────────────────────────────────────── -->
  <ItemGroup>
    <PackageReference Include="SharpDX" Version="4.2.0" />
    <PackageReference Include="SharpDX.DirectInput" Version="4.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="7.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- SkiaSharp replaces System.Drawing.Bitmap/Color for all pixel operations.
         System.Drawing.Common is kept only for System.Drawing.Icon used in dialogs
         (CustomMessageBox / CustomComboBoxes) — will be removed in Phase 4 (Avalonia). -->
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <!-- Speech recognition (SpeechRecognition.fs).  Published as a NuGet package
         for .NET 8; Windows-only at runtime. -->
    <PackageReference Include="System.Speech" Version="8.0.0" />
  </ItemGroup>

  <!-- ───────────────────────────────────────────────────
       Embedded icon sprites (all PNGs in the icons\ folder).
       The .ico file is a Content item so it lands in the output dir and is
       also set as the ApplicationIcon above.
       ─────────────────────────────────────────────────── -->
  <ItemGroup>
    <EmbeddedResource Include="icons\*.png" />
    <Content Include="icons\ztlogo64x64.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="ShowRunCustomImages\all-items-hud.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="ShowRunCustomImages\enemy-drop-table-and-rooms-that-never-drop.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="ShowRunCustomImages\rooms-that-never-drop-text.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Z1R_Tracker\README.txt">
      <Link>README.txt</Link>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="reminder_clink.wav">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="confirm_speech.wav">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="App.config">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- ───────────────────────────────────────────────────
       F# source files — ORDER IS CRITICAL for F# compilation.
       ─────────────────────────────────────────────────── -->
  <ItemGroup>
    <Compile Include="..\GlobalAssemblyInfo.fs">
      <Link>GlobalAssemblyInfo.fs</Link>
    </Compile>
    <Compile Include="Gamepad.fs" />
    <Compile Include="Graphics.fs" />
    <Compile Include="CustomMessageBox.fs" />
    <Compile Include="OverworldRouteDrawing.fs" />
    <Compile Include="DungeonRoomState.fs" />
    <Compile Include="HotKeys.fs" />
    <Compile Include="Timeline.fs" />
    <Compile Include="CustomComboBoxes.fs" />
    <Compile Include="PieMenus.fs" />
    <Compile Include="ShowRunCustom.fs" />
    <Compile Include="Dungeon.fs" />
    <Compile Include="OptionsMenu.fs" />
    <Compile Include="Views.fs" />
    <Compile Include="DungeonSaveAndLoad.fs" />
    <Compile Include="DungeonHighlightsUI.fs" />
    <Compile Include="DungeonPopups.fs" />
    <Compile Include="DungeonUI.fs" />
    <Compile Include="SpeechRecognition.fs" />
    <Compile Include="OverworldMapTileCustomization.fs" />
    <Compile Include="LinkRouting.fs" />
    <Compile Include="Popouts.fs" />
    <Compile Include="OverworldItemGridUI.fs" />
    <Compile Include="UIComponents.fs" />
    <Compile Include="HUDs.fs" />
    <Compile Include="Broadcast.fs" />
    <Compile Include="UIHelpers.fs" />
    <Compile Include="UserCustomLayer.fs" />
    <Compile Include="DrawingLayer.fs" />
    <Compile Include="Layout.fs" />
    <Compile Include="Reminders.fs" />
    <Compile Include="MainTrackerTriforcesAndItems.fs" />
    <Compile Include="Debouncer.fs" />
    <Compile Include="SyncOriginTracker.fs" />
    <Compile Include="DungeonCInterop.fs" />
    <Compile Include="CoopSync.fs" />
    <Compile Include="DungeonModelSync.fs" />
    <Compile Include="WPFUI.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Z1R_SharedInterop\Z1R_SharedInterop.fsproj" />
    <ProjectReference Include="..\Z1R_Sync\Z1R_Sync.csproj" />
    <ProjectReference Include="..\Z1R_Tracker\Z1R_Tracker.fsproj" />
  </ItemGroup>

  <!-- Publish the SignalR host sidecar before every build, then copy its
       single-file exe into our output directory.
       NOTE: Z1R_SignalRHost still targets netcoreapp3.1 + Sdk.Web, which is
       incompatible with the SDK 9 toolchain used on this branch.  Skip by
       default ($(BuildSignalRHost)=false) so normal dev builds are not
       blocked; set -p:BuildSignalRHost=true for release / packaging builds
       once the SignalRHost has been upgraded to net8.0. -->
  <Target Name="PublishSignalRHost" BeforeTargets="BeforeBuild"
          Condition="'$(BuildSignalRHost)' == 'true'">
    <Exec Command="dotnet publish ../Z1R_SignalRHost/Z1R_SignalRHost.csproj -c $(Configuration) -r win-x86 --self-contained true -p:PublishSingleFile=true -o ../Z1R_SignalRHost/bin/$(Configuration)/netcoreapp3.1/win-x86/publish" />
  </Target>
  <Target Name="CopySignalRHostExe" AfterTargets="Build"
          Condition="'$(BuildSignalRHost)' == 'true'">
    <Copy SourceFiles="../Z1R_SignalRHost/bin/$(Configuration)/netcoreapp3.1/win-x86/publish/Z1R_SignalRHost.exe" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

</Project>
