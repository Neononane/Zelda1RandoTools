<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>Z1R_Tracker</AssemblyName>
    <RootNamespace>Z1R_Tracker</RootNamespace>
    <OutputType>Library</OutputType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OtherFlags>--warnon:1182</OtherFlags>
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
    <Tailcalls Condition="'$(Configuration)' == 'Release'">true</Tailcalls>
  </PropertyGroup>

  <!-- System.Drawing.Common is not included in the .NET 8 SDK by default;
       required by any code that uses System.Drawing.Bitmap / System.Drawing.Color. -->
  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <!-- F# source files must be listed in compilation order. -->
  <ItemGroup>
    <Compile Include="..\GlobalAssemblyInfo.fs">
      <Link>GlobalAssemblyInfo.fs</Link>
    </Compile>
    <Compile Include="OverworldData.fs" />
    <Compile Include="DungeonData.fs" />
    <Compile Include="TrackerModelOptions.fs" />
    <Compile Include="TrackerModel.fs" />
    <Compile Include="OverworldRouting.fs" />
    <Compile Include="SaveAndLoad.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Z1R_SharedInterop\Z1R_SharedInterop.fsproj" />
  </ItemGroup>

</Project>
