<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>Z1R_Sync</AssemblyName>
    <RootNamespace>Z1R_Sync</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="7.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- CDungeonRoomState.cs bitmap ops migrated to SkiaSharp (Phase 2) -->
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
  </ItemGroup>

  <!-- SDK auto-globs all *.cs in the project directory; exclude the old
       hand-maintained AssemblyInfo and include the shared one from the repo root. -->
  <ItemGroup>
    <Compile Remove="Properties\AssemblyInfo.cs" />
    <Compile Include="..\GlobalAssemblyInfo.cs">
      <Link>GlobalAssemblyInfo.cs</Link>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Z1R_SharedInterop\Z1R_SharedInterop.fsproj" />
  </ItemGroup>

</Project>
